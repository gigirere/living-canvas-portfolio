{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1100px"
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": true,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "paper", "color": "#DED8CC", "name": "Paper" },
				{ "slug": "ink", "color": "#101010", "name": "Ink" },
				{ "slug": "muted", "color": "#606060", "name": "Muted" },
				{ "slug": "dim", "color": "#808080", "name": "Dim" },
				{ "slug": "diary", "color": "#75D2FE", "name": "Diary blue" },
				{ "slug": "diary-header", "color": "#86BFF8", "name": "Diary blue (light)" },
				{ "slug": "projects", "color": "#A6B99F", "name": "Projects green" },
				{ "slug": "projects-header", "color": "#B4E091", "name": "Projects green (light)" },
				{ "slug": "about", "color": "#F0AF00", "name": "About yellow" },
				{ "slug": "about-header", "color": "#FB9D6E", "name": "About orange" },
				{ "slug": "white", "color": "#FFFFFC", "name": "White" }
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"fluid": false,
			"writingMode": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "System Serif",
					"fontFamily": "ui-serif, Georgia, Cambria, \"Times New Roman\", Times, serif"
				},
				{
					"slug": "sans-serif",
					"name": "System Sans-Serif",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "monospace",
					"name": "System Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "tiny", "size": "10px", "name": "Tiny (label)" },
				{ "slug": "small", "size": "13px", "name": "Small (body)" },
				{ "slug": "medium", "size": "14px", "name": "Medium" },
				{ "slug": "large", "size": "15px", "name": "Large (title)" },
				{ "slug": "x-large", "size": "32px", "name": "X-Large (logo)" }
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": [ "px", "em", "rem", "%", "vw", "vh" ]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"dimensions": { "minHeight": true },
		"position": { "sticky": true },
		"css": "--gp-card-shadow: 0 2px 3px rgba(0,0,0,.2);"
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans-serif)",
			"fontSize": "var(--wp--preset--font-size--small)",
			"fontWeight": "300",
			"lineHeight": "1.3"
		},
		"spacing": {
			"blockGap": "16px",
			"padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" }
		},
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "500",
					"lineHeight": "1.1"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" } }
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.2"
				}
			},
			"core/image": { "spacing": { "margin": { "top": "0", "bottom": "0" } } }
		}
	},
	"customTemplates": [
		{ "name": "canvas", "title": "Card canvas", "postTypes": [ "page" ] }
	]
}
