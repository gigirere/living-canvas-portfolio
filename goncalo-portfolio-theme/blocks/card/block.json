{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "goncalo/card",
	"title": "Card",
	"category": "goncalo",
	"icon": "index-card",
	"description": "A draggable portfolio card. Any core block works inside it \u2014 headings, paragraphs, images, galleries, videos, embeds, columns, quotes \u2014 and they reorder freely. Choose a background colour and an optional header colour.",
	"keywords": [ "card", "portfolio", "panel", "canvas", "container" ],
	"textdomain": "goncalo-portfolio",
	"supports": {
		"html": false,
		"reusable": true,
		"anchor": true
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"bgColor": {
			"type": "string",
			"default": "#75D2FE"
		},
		"headerColor": {
			"type": "string",
			"default": ""
		},
		"width": {
			"type": "number",
			"default": 360
		},
		"height": {
			"type": "number",
			"default": 480
		}
	},
	"editorScript": "gp-card-editor",
	"render": "file:./render.php"
}
